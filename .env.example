# Database
DATABASE_URL=mysql://user:password@localhost:3306/morocco_incoming

# Kimi OAuth (framework required)
APP_ID=your-kimi-app-id
APP_SECRET=your-kimi-app-secret
KIMI_AUTH_URL=https://agents.cn/oauth
KIMI_OPEN_URL=https://agents.cn

# JWT Secret for admin auth (generate a strong random string)
JWT_SECRET=change-me-to-a-secure-random-string-min-32-characters

# One-time database seeding only (do not keep these in production after use)
# SEED_ADMIN_EMAIL=admin@example.com
# SEED_ADMIN_PASSWORD=use-a-unique-password-with-12-or-more-characters

# Email notifications (Resend)
RESEND_API_KEY=re_your_api_key
ADMIN_NOTIFICATION_EMAIL=admin@example.com
NOTIFICATION_FROM_EMAIL=Morocco Incoming <notifications@your-verified-domain.com>
# Optional aliases/settings:
# CONTACT_NOTIFICATION_EMAIL=admin@example.com
# ADMIN_DASHBOARD_URL=https://www.morocco-incoming.com/admin

# Optional
OWNER_UNION_ID=
PORT=3000
